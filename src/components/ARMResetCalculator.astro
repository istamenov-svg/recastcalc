---
/* ARM Reset Calculator
 * Vanilla JS island, mirrors RecastCalculator.astro structure.
 * New rate = index + margin, limited by the initial, periodic, and lifetime caps
 * (see armRatePath in src/scripts/mortgage-math.js). */

import rates from '../data/rates.json';
const r30 = rates.rates["30yr_fixed"];
const sofr = rates.rates["sofr_30day"];
const sofrAsOf = new Date(rates.sofrAsOf + 'T12:00:00Z').toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

---

<section
  id="arm-calculator"
  class="bg-cream-50 border border-ink-200 rounded-lg p-6 md:p-8 shadow-sm"
  aria-labelledby="calculator-heading"
>
  <h2 id="calculator-heading" class="font-display text-2xl font-semibold text-ink-900 mb-2">
    Calculate your ARM reset (and whether refinancing is actually worth it)
  </h2>
  <p class="text-sm text-ink-600 mb-6">
    Enter the terms from your loan documents. When your adjustable-rate mortgage resets, the new rate is the index plus your margin, limited by your caps. See each step of the reset, your worst case, and whether refinancing to a fixed rate costs less over the time you'll keep the loan.
  </p>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- INPUTS -->
    <form id="arm-form" novalidate>
      <div class="space-y-5">
        <div>
          <label for="balance" class="calc-label">Loan balance at the reset</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">$</span>
            <input type="number" id="balance" name="balance" class="calc-input pl-7"
              placeholder="400,000" min="1000" max="10000000" step="1000" value="400000" required inputmode="numeric" />
          </div>
        </div>

        <div>
          <label for="startRate" class="calc-label">
            Starting rate
            <span class="text-ink-400 font-normal">(your rate during the fixed period)</span>
          </label>
          <div class="relative">
            <input type="number" id="startRate" name="startRate" class="calc-input pr-8"
              placeholder="4.5" min="0" max="25" step="0.001" value="4.5" required inputmode="decimal" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">%</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="index" class="calc-label">
              Index
              <span class="text-ink-400 font-normal">(the market rate your loan follows)</span>
            </label>
            <div class="relative">
              <input type="number" id="index" name="index" class="calc-input pr-8"
                placeholder={sofr.toString()} min="0" max="25" step="0.001" value={sofr} required inputmode="decimal" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">%</span>
            </div>
          </div>
          <div>
            <label for="margin" class="calc-label">
              Margin
              <span class="text-ink-400 font-normal">(fixed amount added; check your note)</span>
            </label>
            <div class="relative">
              <input type="number" id="margin" name="margin" class="calc-input pr-8"
                placeholder="2.75" min="0" max="10" step="0.001" value="2.75" required inputmode="decimal" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">%</span>
            </div>
          </div>
        </div>
        <p class="text-xs text-ink-500 -mt-3">
          Index default: the 30-day average of the Secured Overnight Financing Rate (SOFR), {sofr}% on {sofrAsOf}. If your loan uses a different index, enter its value.
        </p>

        <fieldset>
          <legend class="calc-label">
            Rate caps
            <span class="text-ink-400 font-normal">(how far your rate can move, in percentage points)</span>
          </legend>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label for="initialCap" class="text-xs text-ink-600 block mb-1">At the first reset</label>
              <input type="number" id="initialCap" name="initialCap" class="calc-input"
                placeholder="2" min="0" max="20" step="0.5" value="2" required inputmode="decimal" />
            </div>
            <div>
              <label for="periodicCap" class="text-xs text-ink-600 block mb-1">At each later reset</label>
              <input type="number" id="periodicCap" name="periodicCap" class="calc-input"
                placeholder="1" min="0" max="20" step="0.5" value="1" required inputmode="decimal" />
            </div>
            <div>
              <label for="lifetimeCap" class="text-xs text-ink-600 block mb-1">Lifetime, above starting rate</label>
              <input type="number" id="lifetimeCap" name="lifetimeCap" class="calc-input"
                placeholder="5" min="0" max="20" step="0.5" value="5" required inputmode="decimal" />
            </div>
          </div>
          <p class="text-xs text-ink-500 mt-2">Caps are often written as three numbers, such as 2/1/5.</p>
        </fieldset>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="adjustMonths" class="calc-label">Rate changes every</label>
            <select id="adjustMonths" name="adjustMonths" class="calc-input">
              <option value="6" selected>6 months</option>
              <option value="12">12 months</option>
            </select>
          </div>
          <div>
            <label for="firstRate" class="calc-label">
              Your new rate
              <span class="text-ink-400 font-normal">(optional, if your notice states it)</span>
            </label>
            <div class="relative">
              <input type="number" id="firstRate" name="firstRate" class="calc-input pr-8"
                placeholder="" min="0" max="25" step="0.001" inputmode="decimal" />
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">%</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="termYears" class="calc-label">Years remaining</label>
            <input type="number" id="termYears" name="termYears" class="calc-input"
              placeholder="25" min="1" max="50" step="1" value="25" required inputmode="numeric" />
          </div>
          <div>
            <label for="termMonths" class="calc-label">Plus months</label>
            <input type="number" id="termMonths" name="termMonths" class="calc-input"
              placeholder="0" min="0" max="11" step="1" value="0" inputmode="numeric" />
          </div>
        </div>

        <div>
          <label for="refiRate" class="calc-label">Available refinance rate</label>
          <div class="relative">
            <input type="number" id="refiRate" name="refiRate" class="calc-input pr-8"
              placeholder={r30.toString()} min="0" max="25" step="0.001" value={r30} required inputmode="decimal" />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">%</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="closingCosts" class="calc-label">Refi closing costs</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-400 font-mono">$</span>
              <input type="number" id="closingCosts" name="closingCosts" class="calc-input pl-7"
                placeholder="5,000" min="0" max="50000" step="500" value="5000" inputmode="numeric" />
            </div>
          </div>
          <div>
            <label for="holdYears" class="calc-label">
              Years you'll hold
              <span class="text-ink-400 font-normal">(time horizon)</span>
            </label>
            <input type="number" id="holdYears" name="holdYears" class="calc-input"
              placeholder="5" min="1" max="50" step="1" value="5" required inputmode="numeric" />
          </div>
        </div>
      </div>
    </form>

    <!-- RESULTS -->
    <div id="arm-results" aria-live="polite" aria-atomic="true">
      <div class="bg-cream-200 rounded-lg p-5 mb-4">
        <p class="text-xs uppercase tracking-widest text-ink-500 mb-1">Your reset reality check</p>
        <div class="grid grid-cols-2 gap-4 mt-3">
          <div>
            <p class="text-xs text-ink-500 mb-1">Payment at first reset (<span data-result="firstResetRate">6.5%</span>)</p>
            <p class="calc-result text-2xl" data-result="armPayment">$2,701</p>
          </div>
          <div>
            <p class="text-xs text-ink-500 mb-1">Refinance payment</p>
            <p class="calc-result text-2xl text-ink-500" data-result="refiPayment">$2,826</p>
          </div>
        </div>
        <div class="mt-4 pt-4 border-t border-ink-300/50">
          <p class="text-xs text-ink-500 mb-1">Fully indexed rate (index + margin)</p>
          <p class="calc-result text-xl" data-result="fullyIndexedRate">6.66%</p>
        </div>
        <div class="mt-4 pt-4 border-t border-ink-300/50">
          <p class="text-xs text-ink-500 mb-1">Worst case if the rate hits your lifetime cap</p>
          <p class="calc-result text-3xl text-negative" data-result="armWorstCase">$3,495</p>
          <p class="text-xs text-ink-500 mt-1">
            Your rate can never go above <span data-result="lifetimeMaxRate">9.5%</span> under your caps
          </p>
        </div>
      </div>

      <!-- Rate path -->
      <div class="border border-ink-200 rounded-lg overflow-hidden text-sm mb-4">
        <div class="bg-cream-200 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-ink-700 border-b border-ink-200">
          Your rate at each reset (if the index stays the same)
        </div>
        <table class="w-full">
          <thead>
            <tr class="text-left text-xs text-ink-500 border-b border-ink-200">
              <th class="px-4 py-2 font-medium">Reset</th>
              <th class="px-4 py-2 font-medium text-right">Rate</th>
              <th class="px-4 py-2 font-medium text-right">Monthly payment</th>
            </tr>
          </thead>
          <tbody class="font-mono tabular text-ink-800" data-result="ratePath"></tbody>
        </table>
      </div>

      <!-- Comparison: 2 strategies -->
      <div class="border border-ink-200 rounded-lg overflow-hidden text-sm">
        <div class="bg-cream-200 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-ink-700 border-b border-ink-200">
          Two strategies, side-by-side
        </div>
        <table class="w-full">
          <thead>
            <tr class="text-left text-xs text-ink-500 border-b border-ink-200">
              <th class="px-4 py-2 font-medium">Strategy</th>
              <th class="px-4 py-2 font-medium text-right">First payment</th>
              <th class="px-4 py-2 font-medium text-right">Cost over hold</th>
            </tr>
          </thead>
          <tbody class="font-mono tabular text-ink-800">
            <tr class="border-b border-ink-100" data-row="holdArm">
              <td class="px-4 py-3 font-sans text-ink-700">
                <span class="block font-medium">Hold the ARM</span>
                <span class="text-xs text-ink-400">Follow the resets above</span>
              </td>
              <td class="px-4 py-3 text-right" data-result="armMonthly">$2,701</td>
              <td class="px-4 py-3 text-right" data-result="armNetCost">$144,288</td>
            </tr>
            <tr data-row="refinance">
              <td class="px-4 py-3 font-sans text-ink-700">
                <span class="block font-medium">Refinance to fixed</span>
                <span class="text-xs text-ink-400">Lock current refi rate; pay closing</span>
              </td>
              <td class="px-4 py-3 text-right" data-result="refiMonthly">$2,826</td>
              <td class="px-4 py-3 text-right" data-result="refiNetCost">$129,298</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p
        id="best-strategy-callout"
        class="mt-4 text-sm text-ink-700 leading-relaxed"
        data-result="strategyCallout"
      >
        Loading...
      </p>

      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" id="copy-link-btn"
          class="text-xs text-ink-600 hover:text-accent underline underline-offset-2 decoration-ink-300 hover:decoration-accent">
          Copy link to these results
        </button>
        <button type="button" id="print-btn" onclick="window.print()"
          class="text-xs text-ink-600 hover:text-accent underline underline-offset-2 decoration-ink-300 hover:decoration-accent">
          Print / save as PDF
        </button>
      </div>

      <p class="text-xs text-ink-400 mt-4 leading-relaxed">
        Estimates only. The rate path assumes the index stays where it is; it will move. Each reset moves your rate toward index plus margin by no more than your cap, and the rate is assumed never to fall below your margin. Cost over hold is interest paid only (plus closing costs for the refinance). Your loan documents control; confirm your index, margin, caps, and schedule with your servicer.
      </p>
    </div>
  </div>
</section>

<script>
  import { trackCalculatorUsed, trackResultButtons } from '../scripts/analytics.js';
  import { calculateARMReset, formatCurrency } from '../scripts/mortgage-math.js';

  const form = document.getElementById('arm-form');
  const inputs = form.querySelectorAll('input, select');
  const num = (id) => parseFloat(document.getElementById(id).value);

  function getInputs() {
    return {
      currentBalance: num('balance') || 0,
      startRate: num('startRate'),
      index: num('index'),
      margin: num('margin'),
      initialCap: num('initialCap'),
      periodicCap: num('periodicCap'),
      lifetimeCap: num('lifetimeCap'),
      adjustmentMonths: parseInt(document.getElementById('adjustMonths').value) || 6,
      firstRate: num('firstRate') || undefined,
      remainingTermMonths:
        (parseInt(document.getElementById('termYears').value) || 0) * 12 +
        (parseInt(document.getElementById('termMonths').value) || 0),
      refiRate: num('refiRate'),
      refiClosingCosts: num('closingCosts') || 0,
      holdYears: parseInt(document.getElementById('holdYears').value) || 0,
    };
  }

  function setResult(key, value) {
    const el = document.querySelector(`[data-result="${key}"]`);
    if (el) el.textContent = value;
  }

  const pct = (r) => `${Number(r.toFixed(3))}%`;

  function highlightWinner(winner) {
    document.querySelectorAll('[data-row]').forEach((row) => {
      row.classList.remove('bg-accent-50/30');
    });
    const winningRow = document.querySelector(`[data-row="${winner}"]`);
    if (winningRow) winningRow.classList.add('bg-accent-50/30');
  }

  function renderPath(result) {
    const body = document.querySelector('[data-result="ratePath"]');
    if (!body) return;
    body.replaceChildren(...result.ratePath.map((step) => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-ink-100';
      const when = step.reset === 1
        ? 'First reset'
        : `${step.month - 1} months later`;
      [when, pct(step.rate), formatCurrency(step.payment)].forEach((text, i) => {
        const td = document.createElement('td');
        td.className = i === 0 ? 'px-4 py-2 font-sans text-ink-700' : 'px-4 py-2 text-right';
        td.textContent = text;
        tr.appendChild(td);
      });
      return tr;
    }));
  }

  function update() {
    const params = getInputs();
    const result = calculateARMReset(params);

    if (!result) {
      setResult('strategyCallout', 'Enter valid loan details to see your reset analysis.');
      return;
    }

    setResult('firstResetRate', pct(result.firstResetRate));
    setResult('armPayment', formatCurrency(result.holdArm.monthlyPayment));
    setResult('refiPayment', formatCurrency(result.refinance.monthlyPayment));
    setResult('fullyIndexedRate', pct(result.fullyIndexedRate));
    setResult('armWorstCase', formatCurrency(result.holdArm.worstCaseMonthlyPayment));
    setResult('lifetimeMaxRate', pct(result.lifetimeMaxRate));
    renderPath(result);

    setResult('armMonthly', formatCurrency(result.holdArm.monthlyPayment));
    setResult('armNetCost', formatCurrency(result.holdArm.netCostOverHold));
    setResult('refiMonthly', formatCurrency(result.refinance.monthlyPayment));
    setResult('refiNetCost', formatCurrency(result.refinance.netCostOverHold));

    highlightWinner(result.bestStrategy);

    /* Honest callout */
    const steps = result.ratePath.length;
    const pathNote = steps > 1
      ? ` Your rate would reach ${pct(result.targetRate)} after ${steps - 1} more reset${steps > 2 ? 's' : ''}, for a payment of about ${formatCurrency(result.holdArm.targetMonthlyPayment)}; plan for that, not just the first step.`
      : '';
    let callout = '';
    if (result.bestStrategy === 'holdArm') {
      callout = `<strong class="text-ink-900">Hold the ARM.</strong> Refinancing would cost you ${formatCurrency(result.differenceOverHold)} more over your ${params.holdYears}-year hold (interest plus the ${formatCurrency(params.refiClosingCosts)} closing costs), if the index stays where it is.${pathNote} Your worst case is bounded: even at your lifetime cap (${pct(result.lifetimeMaxRate)}), your payment cannot exceed ${formatCurrency(result.holdArm.worstCaseMonthlyPayment)}/month.`;
    } else {
      callout = `<strong class="text-ink-900">Refinancing wins by ${formatCurrency(result.differenceOverHold)} over your ${params.holdYears}-year hold</strong>, even after paying ${formatCurrency(params.refiClosingCosts)} in closing costs, if the index stays where it is.${pathNote} If you'll hold even longer than ${params.holdYears} years, the refi advantage grows.`;
    }

    const calloutEl = document.querySelector('[data-result="strategyCallout"]');
    if (calloutEl) calloutEl.innerHTML = callout;
    return true;
  }

  // Count a use once the visitor's own values produce results (defaults show on load)
  function onUserInput() {
    if (update()) trackCalculatorUsed('arm_reset');
  }

  inputs.forEach((input) => {
    input.addEventListener('input', onUserInput);
    input.addEventListener('change', onUserInput);
  });

  update();

  // Shareable URL. Keys: b balance, o starting rate, i index, m margin, ic/pc/c caps,
  // a adjustment months, n stated new rate (optional), t term, r refi rate, cc closing, h hold.
  document.getElementById('copy-link-btn')?.addEventListener('click', () => {
    const params = getInputs();
    const url = new URL(window.location.href);
    const q = {
      b: params.currentBalance,
      o: params.startRate,
      i: params.index,
      m: params.margin,
      ic: params.initialCap,
      pc: params.periodicCap,
      c: params.lifetimeCap,
      a: params.adjustmentMonths,
      t: params.remainingTermMonths,
      r: params.refiRate,
      cc: params.refiClosingCosts,
      h: params.holdYears,
    };
    if (params.firstRate) q.n = params.firstRate;
    url.search = new URLSearchParams(q).toString();
    navigator.clipboard.writeText(url.toString()).then(() => {
      const btn = document.getElementById('copy-link-btn');
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = original), 2000);
    });
  });

  // Hydrate from a shared link. Older links carried only n (expected new rate), which now
  // fills "Your new rate".
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.has('b')) {
    const map = {
      b: 'balance', o: 'startRate', i: 'index', m: 'margin', ic: 'initialCap', pc: 'periodicCap',
      c: 'lifetimeCap', a: 'adjustMonths', n: 'firstRate', r: 'refiRate', cc: 'closingCosts', h: 'holdYears',
    };
    for (const [key, id] of Object.entries(map)) {
      if (urlParams.has(key)) document.getElementById(id).value = urlParams.get(key);
    }
    const t = parseInt(urlParams.get('t') || '0');
    if (t > 0) {
      document.getElementById('termYears').value = Math.floor(t / 12);
      document.getElementById('termMonths').value = t % 12;
    }
    update();
  }

  trackResultButtons('arm_reset');
</script>
