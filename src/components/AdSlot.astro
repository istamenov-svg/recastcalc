---
export interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal' | 'vertical';
  variant?: 'inline' | 'sidebar' | 'mobile-anchor';
  label?: boolean;
}

const {
  slot = 'TODO_SLOT_ID', // TODO: replace with real ad unit slot IDs after AdSense approval
  format = 'auto',
  variant = 'inline',
  label = true,
} = Astro.props;

// Ads render nothing unless ADS_ENABLED=true is set at build time.
const adsEnabled = process.env.ADS_ENABLED === 'true';

const variantClass = {
  'inline': 'ad-slot ad-slot--inline',
  'sidebar': 'ad-slot',
  'mobile-anchor': 'ad-slot ad-slot--mobile-anchor',
}[variant];
---

{adsEnabled && (
  <div class={variantClass} aria-label="Advertisement">
    {label && (
      <p class="text-[10px] uppercase tracking-widest text-ink-400 mb-2">Advertisement</p>
    )}
    <!--
    Uncomment after AdSense approval, once real slot IDs replace TODO_SLOT_ID:

    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-1634869400564839"
         data-ad-slot={slot}
         data-ad-format={format}
         data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    -->
    <div class="border border-dashed border-ink-200 rounded p-8 text-xs text-ink-400 italic">
      AdSense slot (activates after approval)
    </div>
  </div>
)}
